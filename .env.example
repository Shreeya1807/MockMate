AI_MODE=demo
# Live mode requires a model that supports strict structured outputs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=data/mockmate.sqlite
# embedded for local development; external for the Compose worker service
WORKER_MODE=embedded
TRUST_PROXY=0
# Optional TURN for WebRTC across NAT/firewalls. Use short-lived credentials.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional bearer secret for /metrics. Empty disables the endpoint.
METRICS_TOKEN=
